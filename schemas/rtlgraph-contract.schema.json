{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas partial RTL scheduling handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "config",
    "source_ir_sha256",
    "compiler",
    "source",
    "profiles",
    "footprints",
    "semantics",
    "limitations",
    "merlin",
    "query"
  ],
  "properties": {
    "schema": {
      "const": "atlas.rtlgraph.contract.v1"
    },
    "config": {
      "const": "EE290SimConfig"
    },
    "source_ir_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "compiler": {
      "$ref": "#/$defs/artifact"
    },
    "source": {
      "$ref": "#/$defs/artifact"
    },
    "footprints": {
      "$ref": "#/$defs/artifact"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "projection",
          "evidence"
        ],
        "properties": {
          "role": {
            "enum": [
              "mxu0",
              "mxu1",
              "dma",
              "lsu"
            ]
          },
          "projection": {
            "$ref": "#/$defs/artifact"
          },
          "evidence": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "semantics": {
      "type": "object",
      "description": "Versioned consumer obligations; validated exactly by rtlgraph_contract.py."
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "merlin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "adapter_status",
        "precision_loss"
      ],
      "properties": {
        "reference": {
          "type": "string"
        },
        "adapter_status": {
          "const": "no-lossless-gap-projection"
        },
        "precision_loss": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "log"
      ],
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "log": {
          "$ref": "#/$defs/artifact"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "description": "A partial model bound to one native assembly input and compiler binary. Artifact paths other than compiler are relative to the bundle. The loader additionally checks bytes, profile/evidence agreement, one common hardware IR and unique profile roles."
}
