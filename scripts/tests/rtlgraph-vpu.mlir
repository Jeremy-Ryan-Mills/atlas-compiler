  %eq2_29 = comb.icmp eq %inst2, %c29 : i5
  %m1_29 = comb.mux %eq1_29, %mask29, %m1_28 : i31
  %m2_29 = comb.mux %eq2_29, %mask29, %m2_28 : i31
  %row = comb.or %eq1_13, %eq1_19, %eq1_20 : i1
  %notrow = comb.xor %row, %one : i1
  %double2 = comb.or %notrow, %done2 : i1
  %doubleDone = comb.and %done1, %double2 : i1
  %doubleMask = comb.mux %doubleDone, %zero, %all : i31
  %only1done = comb.mux %done1, %m2_29, %all : i31
  %oneDone = comb.mux %done2, %m1_29, %only1done : i31
  %bothDone = comb.and %done1, %done2 : i1
  %singleMask = comb.mux %bothDone, %zero, %oneDone : i31
  %idle = comb.icmp eq %state, %s0 : i2
  %single = comb.icmp eq %state, %s1 : i2
  %double = comb.icmp eq %state, %s2 : i2
  %two = comb.mux %double, %doubleMask, %all : i31
  %some = comb.mux %single, %singleMask, %two : i31
  %mask = comb.mux %idle, %zero, %some : i31
  hw.output %mask : i31
}

hw.module @Release(in %writeDone1: i1, in %io_in_dataOutFire1: i1,
    in %writeCounter1: i7, in %writeLim1: i7,
    in %writeDone2: i1, in %io_in_dataOutFire2: i1,
    in %writeCounter2: i7, in %writeLim2: i7, out done1: i1, out done2: i1) {
  %eq1 = comb.icmp eq %writeCounter1, %writeLim1 : i7
  %last1 = comb.and %io_in_dataOutFire1, %eq1 : i1
  %done1 = comb.or %writeDone1, %last1 : i1
  %eq2 = comb.icmp eq %writeCounter2, %writeLim2 : i7
  %last2 = comb.and %io_in_dataOutFire2, %eq2 : i1
  %done2 = comb.or %writeDone2, %last2 : i1
  hw.output %done1, %done2 : i1, i1
}
